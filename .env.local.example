# Copia a .env.local y completa con tu key de https://www.themoviedb.org/settings/api
TMDB_API_KEY=tu_api_key_aqui

# Server2 (NSR Play). La key se genera en https://nsrplay.space/dashboard
# Solo se usa en el servidor: nunca viaja al navegador.
NSR_API_KEY=np_live_tu_api_key_aqui

# Server1 (Unlimplay) vía Cloudflare Worker. Obligatorio: la app ya no
# scrapea desde Vercel, todo sale por el Worker.
# Se despliega con: cd workers/unlimplay && npx wrangler deploy
UNLIMPLAY_WORKER_URL=https://homex-unlimplay.TU-SUBDOMINIO.workers.dev
# Debe coincidir con el secreto WORKER_TOKEN del Worker
# (npx wrangler secret put WORKER_TOKEN).
UNLIMPLAY_WORKER_TOKEN=pega_aqui_el_secreto
